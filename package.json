{
  "name": "kendibo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "KENDIBO modular monolith — NestJS-style TypeScript, Postgres/PostGIS, Redis. Payments: Bachs.io",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/apps/api/src/main.js",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --import ./tests/setup-env.ts --test --test-force-exit \"tests/*.test.ts\"",
    "test:adversarial": "node tests/adversarial.js",
    "migrate": "node scripts/migrate.js",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:probe": "tsx scripts/probe.ts",
    "db:verify": "tsx scripts/verify-live.ts",
    "ml:train": "tsx scripts/train-matcher.ts",
    "start": "node dist/apps/api/src/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/multipart": "^10.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "basic-ftp": "^6.2.2",
    "bullmq": "^5.12.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.3.0",
    "fastify-raw-body": "^6.0.1",
    "firebase-admin": "^14.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.0",
    "pg-mem": "^3.0.14",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "typescript": "~5.9.3",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
