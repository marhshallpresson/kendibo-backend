{
  "name": "kendibo-backend",
  "version": "0.1.0",
  "private": true,
  "description": "KENDIBO modular monolith — NestJS-style TypeScript, Postgres/PostGIS, Redis. Payments: Bachs.io (primary) + Flutterwave (fallback)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start:api": "node dist/apps/api/src/main.js",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.js",
    "test:adversarial": "node tests/adversarial.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/cors": "^11.3.0",
    "bullmq": "^5.12.0",
    "fastify": "^5.3.0",
    "firebase-admin": "^14.5.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.0.15",
    "pg": "^8.13.0",
    "pg-mem": "^3.0.14",
    "pino": "^9.6.0",
    "socket.io": "^4.8.1",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3"
  }
}
