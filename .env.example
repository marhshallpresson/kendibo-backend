# KENDIBO Backend — Environment Variables Template (do NOT commit real secrets)
# ------------------------------------------------------------
# Hosting: Pxxl (pxxl.app). No AWS services are used anywhere in this backend.
# Live deploy: https://api-kendibo.pxxlspace.cv (NODE_ENV=production on Pxxl)

# -----------------------------------------------------------------------
# Core runtime
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Prod CORS allowlist (comma‑separated). Native Expo apps send no Origin and are always allowed;
# Expo WEB builds send their https origin — list it here.
# Expo dev URLs (Metro localhost/LAN, devtools ports) are auto‑allowed in dev.
CORS_ORIGINS=https://api-kendibo.pxxlspace.cv,https://kendibo.pxxlspace.cv

# -----------------------------------------------------------------------
# Database / Cache (Pxxl managed)
# Local dev: leave DATABASE_URL empty to use the in‑process pg‑mem database.
# Pxxl: paste the managed instance URL, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=
REDIS_URL=

# -----------------------------------------------------------------------
# Media storage (FTP / S3 / Local)
# --- Self‑hosted FTP media (STORAGE_DRIVER=ftp). Fill to pentest the FTP flow.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASS=
FTP_SECURE=false
FTP_BASE_DIR=kendibo-media
# --- Object storage (Pxxl CDN Storage, S3‑compatible)
# Dashboard/API: create bucket `kendibo-media` (private) + access key (read_write).
# STORAGE_DRIVER=local for single‑container dev; =ftp for self‑hosted FTP media; =s3 on Pxxl.
STORAGE_DRIVER=local
STORAGE_ENDPOINT=https://storage.pxxl.app/s3
STORAGE_REGION=auto
STORAGE_BUCKET=kendibo-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MEDIA_SIGN_SECRET=change-me-local-signed-urls

# -----------------------------------------------------------------------
# Authentication
JWT_ACCESS_SECRET=change-me-15min
JWT_REFRESH_SECRET=change-me-rotate

# -----------------------------------------------------------------------
# Payment providers
# Bachs.io — the only payment provider (sandbox first per https://docs.bachs.io).
# Live keys only in production; GET /v1/admin/integrations flags a sandbox key there.
BACHS_API_KEY=sk_sandbox_...
BACHS_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=whsec_...
BACHS_ACCOUNT_ID=acct_...
BACHS_SUCCESS_URL=kendibo://payment/callback
BACHS_CANCEL_URL=kendibo://payment/callback

# -----------------------------------------------------------------------
# Communications (Sling Omnichannel Engine)
# Docs: https://docs.hellosling.com
SLING_API_TOKEN=
SLING_BASE_URL=https://app.sling.com.ng/api/v2
SLING_V1_BASE_URL=https://app.sling.com.ng/api/v1
SLING_SMS_SENDER=KENDIBO
SLING_WHATSAPP_SENDER=KENDIBO
SLING_RCS_SENDER=KENDIBO
SLING_TRUECALLER_SENDER=KENDIBO
SLING_EMAIL_SENDER=hello@kendibo.com   # address used for email channel
SLING_WEBHOOK_SECRET=
SLING_DEFAULT_GROUP_ID=
SLING_ONBOARDING_FORM_ID=
# Enable / disable specific channels (optional flags)
ENABLE_SMS=true
ENABLE_WHATSAPP=true
ENABLE_RCS=true
ENABLE_TRUECALLER=true
ENABLE_EMAIL=true

# -----------------------------------------------------------------------
# AI‑Assisted CTA Campaigns & Retainers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# -----------------------------------------------------------------------
# Fallback communications (Termii SMS / Resend / FCM Push)
TERMII_API_KEY=
TERMII_SENDER=KENDIBO
RESEND_API_KEY=
EMAIL_FROM=no-reply@kendibo.ng
FCM_SERVER_KEY=

# -----------------------------------------------------------------------
# KYC & KYB – Prembly (IdentityPass) – production adapter
# Docs: https://docs.prembly.com
# Set KYC_PROVIDER=prembly + PREMBLY_API_KEY + PREMBLY_APP_ID for live verification.
KYC_PROVIDER=prembly
PREMBLY_API_KEY=
PREMBLY_APP_ID=
PREMBLY_BASE_URL=https://api.prembly.com
PREMBLY_MCP_URL=https://mcp.prembly.com/mcp
PREMBLY_COUNTRY=NG
# Optional: custom endpoint for KYB (vendor verification)
PREMBLY_KYB_ENDPOINT=/kyb/verify   # leave as default unless overridden

# --- KYC spend control (see modules/kyc/kyc-cost.guard.ts) ---------------
# Unit prices from YOUR Prembly contract, in kobo (₦1 = 100 kobo). Used for the
# cost ledger, budget caps and (optionally) passing the cost to the vendor.
KYC_COST_NIN_KOBO=0
KYC_COST_NIN_FACE_KOBO=0
KYC_COST_BVN_KOBO=0
KYC_COST_BVN_FACE_KOBO=0
KYC_COST_DOC_FACE_KOBO=0
KYC_COST_LIVENESS_KOBO=0
KYC_COST_CAC_KOBO=0
KYC_COST_BANK_KOBO=0
# Hard caps; checks fail closed with KYC_*_BUDGET_REACHED when hit. 0 = no cap.
KYC_DAILY_BUDGET_KOBO=0
KYC_MONTHLY_BUDGET_KOBO=0
# Billable calls allowed per person per check type per 24h (retries, abuse).
KYC_MAX_ATTEMPTS_PER_DAY=3
# Reuse a passed ID lookup for this many days instead of paying again.
KYC_CACHE_DAYS=180
# SECRET. HMAC key for cache lookups (falls back to JWT_ACCESS_SECRET).
KYC_CACHE_SECRET=
# true = a vendor's own verification cost is added to their fee ledger and
# recovered from earnings at payout (never charged up front).
KYC_FEE_PASSTHROUGH=false

# -----------------------------------------------------------------------
# Vendor platform
# Category rules (KYC tier, licence, capacity) gate dispatch and offer
# acceptance. Always enforced in production; set true to enforce locally.
VENDOR_ELIGIBILITY_ENFORCED=false
# Public base for vendor share links: <base>/s/<slug>
STOREFRONT_BASE_URL=https://api-kendibo.pxxlspace.cv

# -----------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — booking assistant
# Webhook URL to register in Meta: <API>/webhooks/whatsapp
# SECRET. Permanent System User token with whatsapp_business_messaging only.
WHATSAPP_ACCESS_TOKEN=
# CONFIG. WhatsApp Manager → API setup → Phone number ID (not the phone number).
WHATSAPP_PHONE_NUMBER_ID=
# SECRET. Meta App Secret — verifies X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# SECRET. Any long random string you choose; paste the same value in Meta.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
# CONFIG. The business number in international format (e.g. 2348012345678);
# used for "Back to WhatsApp" buttons on the location / vendors pages.
WHATSAPP_BUSINESS_NUMBER=
# SECRET. Signs the links the bot sends (map pin, vendor list). Falls back to
# JWT_ACCESS_SECRET; set its own value so rotating one never breaks the other.
WHATSAPP_LINK_SECRET=
# CONFIG. Public base URL the /w/* pages are served from (this API host).
WHATSAPP_WEB_BASE_URL=https://api-kendibo.pxxlspace.cv
# CONFIG. Map start point "lat,lng" when the customer has not shared GPS (Uyo).
WHATSAPP_MAP_DEFAULT_CENTER=5.0377,7.9128

# -----------------------------------------------------------------------
# WhatsApp AI agent (Anthropic Claude). Without a key the bot runs the
# deterministic menu flow instead.
# SECRET. console.anthropic.com → API keys. Server only.
ANTHROPIC_API_KEY=
# CONFIG. claude-opus-5-5 (default, best judgement) or claude-haiku-5-5
# (fastest + cheapest for high message volume).
WHATSAPP_AI_MODEL=claude-opus-5-5

# -----------------------------------------------------------------------
# Google Maps Platform (location picker page)
# PUBLIC (browser) key — restrict it in Google Cloud to HTTP referrer
# <WHATSAPP_WEB_BASE_URL>/* and to Maps JavaScript API + Places API (New)
# + Geocoding API only. Without it the page falls back to GPS + typed address.
GOOGLE_MAPS_BROWSER_KEY=

# -----------------------------------------------------------------------
# Push (FCM HTTP v1 via firebase-admin). The legacy FCM_SERVER_KEY API is
# retired by Google; use a service account instead. SECRET.
FIREBASE_SERVICE_ACCOUNT_JSON=
# or a path to the JSON file:
GOOGLE_APPLICATION_CREDENTIALS=

# -----------------------------------------------------------------------
# Observability (WatchUp primary surface, Sentry/PostHog/Datadog patterns behind port)
WATCHUP_API_KEY=
WATCHUP_PROJECT_ID=
WATCHUP_ENV=staging
WATCHUP_RELEASE=dev
SENTRY_DSN=
POSTHOG_KEY=

# -----------------------------------------------------------------------
# Additional optional flags (tune as needed)
# ENABLE_PREMBLY_KYB=true   # set to true when vendor KYB flow is implemented
# ENABLE_VENDOR_ONBOARDING=true
